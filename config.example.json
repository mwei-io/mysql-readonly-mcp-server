{
  "maxLimit": 1000,
  "connections": {
    "user-server": {
      "host": "127.0.0.1",
      "port": 3306,
      "user": "readonly_user",
      "password": "${MYSQL_READONLY_PASSWORD}",
      "database": "users,logs"
    },
    "log-server": {
      "host": "127.0.0.2",
      "port": 3307,
      "user": "readonly_user",
      "password": "${MYSQL_LOG_PASSWORD}",
      "database": "logs"
    }
  },
  "log": {
    "enabled": false,
    "level": "info",
    "dir": "./logs",
    "keepDays": 7
  }
}
